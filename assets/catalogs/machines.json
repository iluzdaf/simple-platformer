{
  "machines": {
    "spider": {
      "states": [
        { "name": "patrol", "does": { "kind": "lua", "script": "spider", "activity": "patrol" } },
        { "name": "pursue", "does": { "kind": "lua", "script": "spider", "activity": "pursue" } }
      ],
      "transitions": [
        { "from": "patrol", "to": "pursue", "when": { "targetVisible": true } },
        {
          "from": "pursue",
          "to": "patrol",
          "when": { "targetKnown": false, "biteReady": true },
          "after": 1.5
        }
      ]
    },
    "boar": {
      "states": [
        { "name": "sleep", "does": { "kind": "lua", "script": "boar", "activity": "sleep" } },
        { "name": "charge", "does": { "kind": "lua", "script": "boar", "activity": "charge" } },
        { "name": "stunned", "does": { "kind": "lua", "script": "boar", "activity": "stunned" } }
      ],
      "transitions": [
        {
          "from": "sleep",
          "to": "charge",
          "when": {
            "heardLanding": true,
            "targetOnSameRun": true,
            "targetWithinNoticeDistance": true
          }
        },
        { "from": "charge", "to": "stunned", "when": { "movementBlocked": true } },
        {
          "from": "stunned",
          "to": "charge",
          "when": { "targetOnSameRun": true, "targetWithinNoticeDistance": true },
          "after": 1.5
        },
        { "from": "stunned", "to": "sleep", "when": { "targetOnSameRun": false }, "after": 1.5 },
        {
          "from": "stunned",
          "to": "sleep",
          "when": { "targetWithinNoticeDistance": false },
          "after": 1.5
        }
      ]
    },
    "rat": {
      "states": [
        { "name": "patrol", "does": "patrol" },
        { "name": "flee", "does": { "kind": "lua", "script": "rat", "activity": "flee" } },
        { "name": "bite", "does": "bite" }
      ],
      "transitions": [
        {
          "from": "patrol",
          "to": "flee",
          "when": { "targetVisible": true, "targetWithinStandoffDistance": true }
        },
        { "from": "flee", "to": "bite", "when": { "targetInBiteRange": true } },
        { "from": "flee", "to": "patrol", "when": { "targetKnown": false }, "after": 1.5 },
        {
          "from": "bite",
          "to": "patrol",
          "when": { "targetKnown": false, "biteReady": true }
        },
        { "from": "bite", "to": "flee", "when": { "biteReady": true } }
      ]
    },
    "keep_distance": {
      "states": [
        { "name": "idle", "does": "idle" },
        { "name": "patrol", "does": "patrol" },
        { "name": "retreat", "does": "retreat" },
        { "name": "shoot", "does": "shoot" },
        { "name": "chase", "does": "chase" },
        { "name": "watch", "does": "watch" }
      ],
      "transitions": [
        {
          "from": ["idle", "patrol", "watch"],
          "to": "retreat",
          "when": { "targetWithinStandoffDistance": true }
        },
        { "from": ["idle", "patrol", "watch"], "to": "shoot", "when": { "targetInSights": true } },
        { "from": ["idle", "patrol", "watch"], "to": "chase", "when": { "targetKnown": true } },
        { "from": "idle", "to": "patrol", "when": { "hasPatrol": true } },
        {
          "from": ["chase", "shoot"],
          "to": "retreat",
          "when": { "targetWithinStandoffDistance": true }
        },
        { "from": "chase", "to": "shoot", "when": { "targetInSights": true } },
        {
          "from": "shoot",
          "to": "chase",
          "when": { "targetKnown": true, "targetInSights": false }
        },
        { "from": ["chase", "shoot", "retreat"], "to": "watch", "when": { "targetKnown": false } },
        {
          "from": "retreat",
          "to": "shoot",
          "when": { "targetWithinStandoffDistance": false, "targetInSights": true }
        },
        {
          "from": "retreat",
          "to": "chase",
          "when": { "targetWithinStandoffDistance": false, "targetKnown": true }
        },
        { "from": "watch", "to": "patrol", "when": { "searchTimeUp": true, "hasPatrol": true } },
        { "from": "watch", "to": "idle", "when": { "searchTimeUp": true } }
      ]
    }
  }
}
